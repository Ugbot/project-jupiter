int GHI_MetalBackend::convertFormat(Format format) {
    // Format → MTL::PixelFormat
    switch (format) {
        case Format::RGBA8_UNORM: return static_cast<int>(MTL::PixelFormatRGBA8Unorm);
        case Format::RGBA8_SRGB: return static_cast<int>(MTL::PixelFormatRGBA8Unorm_sRGB);
        case Format::R32_FLOAT: return static_cast<int>(MTL::PixelFormatR32Float);
        case Format::RGBA32_FLOAT: return static_cast<int>(MTL::PixelFormatRGBA32Float);
        case Format::Depth32F: return static_cast<int>(MTL::PixelFormatDepth32Float);
        case Format::Depth24_Stencil8: return static_cast<int>(MTL::PixelFormatDepth24Unorm_Stencil8);
        default: return static_cast<int>(MTL::PixelFormatRGBA8Unorm);
    }
}

int GHI_MetalBackend::convertPrimitiveTopology(PrimitiveTopology topology) {
    // PrimitiveTopology → MTL::PrimitiveType
    switch (topology) {
        case PrimitiveTopology::TriangleList: return static_cast<int>(MTL::PrimitiveTypeTriangle);
        case PrimitiveTopology::TriangleStrip: return static_cast<int>(MTL::PrimitiveTypeTriangleStrip);
        case PrimitiveTopology::LineList: return static_cast<int>(MTL::PrimitiveTypeLine);
        case PrimitiveTopology::LineStrip: return static_cast<int>(MTL::PrimitiveTypeLineStrip);
        case PrimitiveTopology::PointList: return static_cast<int>(MTL::PrimitiveTypePoint);
        default: return static_cast<int>(MTL::PrimitiveTypeTriangle);
    }
}

