void GHI_MetalBackend::beginFrame() {
    MTL::CommandQueue* mtlQueue = reinterpret_cast<MTL::CommandQueue*>(commandQueue_);
    
    // Create command buffer for this frame (metal-cpp C++ API)
    currentCommandBuffer_ = mtlQueue->commandBuffer();  // Store as void*
    
    LOG_INFO("GHI_Metal", "Begin frame");
}

void GHI_MetalBackend::endFrame() {
    if (!currentCommandBuffer_) {
        return;
    }
    
    MTL::CommandBuffer* mtlCmdBuffer = reinterpret_cast<MTL::CommandBuffer*>(currentCommandBuffer_);
    
    // Present drawable if we have one
    if (currentDrawable_) {
        CA::MetalDrawable* drawable = reinterpret_cast<CA::MetalDrawable*>(currentDrawable_);
        mtlCmdBuffer->presentDrawable(drawable);
        currentDrawable_ = nullptr;
    }
    
    // Commit command buffer (metal-cpp C++ API)
    mtlCmdBuffer->commit();
    currentCommandBuffer_ = nullptr;
    
    LOG_INFO("GHI_Metal", "End frame");
}

void GHI_MetalBackend::beginRenderPass() {
    if (!currentCommandBuffer_) {
        LOG_ERROR("GHI_Metal", "Cannot begin render pass: no active command buffer");
        return;
    }
    
    MTL::CommandBuffer* mtlCmdBuffer = reinterpret_cast<MTL::CommandBuffer*>(currentCommandBuffer_);
    
    // TODO: Create render pass descriptor with clear values
    // For now, stub
    LOG_INFO("GHI_Metal", "Begin render pass (stub)");
}

void GHI_MetalBackend::endRenderPass() {
    if (currentRenderEncoder_) {
        MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
        encoder->endEncoding();
        currentRenderEncoder_ = nullptr;
    }
    
    LOG_INFO("GHI_Metal", "End render pass");
}

void GHI_MetalBackend::setViewport(uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
    if (!currentRenderEncoder_) return;
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    
    // Set viewport (metal-cpp C++ API)
    MTL::Viewport viewport = {
        static_cast<double>(x),
        static_cast<double>(y),
        static_cast<double>(width),
        static_cast<double>(height),
        0.0,  // znear
        1.0   // zfar
    };
    encoder->setViewport(viewport);
}

void GHI_MetalBackend::setScissor(uint32_t x, uint32_t y, uint32_t width, uint32_t height) {
    if (!currentRenderEncoder_) return;
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    
    // Set scissor rect (metal-cpp C++ API)
    MTL::ScissorRect scissor = { x, y, width, height };
    encoder->setScissorRect(scissor);
}

// Note: draw, drawIndexed, dispatch, dispatchIndirect
// are implemented in ghi_metal_complete.cpp

void GHI_MetalBackend::drawIndirect(BufferHandle indirectBuffer, uint32_t drawCount, uint32_t stride) {
    if (!currentRenderEncoder_) return;
    
    auto it = buffers_.find(indirectBuffer.id);
    if (it == buffers_.end()) {
        LOG_ERROR("GHI_Metal", "Invalid indirect buffer");
        return;
    }
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    MTL::Buffer* mtlBuffer = reinterpret_cast<MTL::Buffer*>(it->second);
    
    // Indirect draw (metal-cpp C++ API)
    encoder->drawPrimitives(
        MTL::PrimitiveTypeTriangle,
        mtlBuffer,
        0  // offset
    );
}

void GHI_MetalBackend::dispatch(uint32_t groupCountX, uint32_t groupCountY, uint32_t groupCountZ) {
    if (!currentComputeEncoder_) {
        LOG_ERROR("GHI_Metal", "Cannot dispatch: no active compute encoder");
        return;
    }
    
    MTL::ComputeCommandEncoder* encoder = reinterpret_cast<MTL::ComputeCommandEncoder*>(currentComputeEncoder_);
    
    // Dispatch compute (metal-cpp C++ API)
    MTL::Size gridSize = MTL::Size(groupCountX, groupCountY, groupCountZ);
    MTL::Size threadgroupSize = MTL::Size(8, 8, 1);  // TODO: Get from shader
    encoder->dispatchThreadgroups(gridSize, threadgroupSize);
}

void GHI_MetalBackend::dispatchIndirect(BufferHandle indirectBuffer) {
    // TODO: Metal indirect compute dispatch
    LOG_INFO("GHI_Metal", "dispatchIndirect (stub)");
}

void GHI_MetalBackend::setRenderState(const RenderState& state) {
    currentState_ = state;
    // Metal state is set during pipeline creation, not dynamically
}

void GHI_MetalBackend::getRenderState(RenderState& state) {
    state = currentState_;
}

void GHI_MetalBackend::bindVertexBuffer(BufferHandle buffer, uint32_t binding, size_t offset) {
    if (!currentRenderEncoder_) return;
    
    auto it = buffers_.find(buffer.id);
    if (it == buffers_.end()) return;
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    MTL::Buffer* mtlBuffer = reinterpret_cast<MTL::Buffer*>(it->second);
    
    // Bind vertex buffer (metal-cpp C++ API)
    encoder->setVertexBuffer(mtlBuffer, offset, binding);
}

void GHI_MetalBackend::bindIndexBuffer(BufferHandle buffer, size_t offset) {
    // Metal binds index buffer in draw call, not separately
    // Store for later use in drawIndexed
}

void GHI_MetalBackend::bindUniformBuffer(BufferHandle buffer, uint32_t set, uint32_t binding) {
    if (!currentRenderEncoder_) return;
    
    auto it = buffers_.find(buffer.id);
    if (it == buffers_.end()) return;
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    MTL::Buffer* mtlBuffer = reinterpret_cast<MTL::Buffer*>(it->second);
    
    // Bind uniform buffer (metal-cpp C++ API)
    // Metal uses buffer index, not descriptor sets
    uint32_t bufferIndex = set * 10 + binding;  // Simple mapping
    encoder->setVertexBuffer(mtlBuffer, 0, bufferIndex);
    encoder->setFragmentBuffer(mtlBuffer, 0, bufferIndex);
}

void GHI_MetalBackend::bindTexture(TextureHandle texture, uint32_t set, uint32_t binding) {
    if (!currentRenderEncoder_) return;
    
    auto it = textures_.find(texture.id);
    if (it == textures_.end()) return;
    
    MTL::RenderCommandEncoder* encoder = reinterpret_cast<MTL::RenderCommandEncoder*>(currentRenderEncoder_);
    MTL::Texture* mtlTexture = reinterpret_cast<MTL::Texture*>(it->second);
    
    // Bind texture (metal-cpp C++ API)
    uint32_t textureIndex = set * 10 + binding;  // Simple mapping
    encoder->setFragmentTexture(mtlTexture, textureIndex);
}

