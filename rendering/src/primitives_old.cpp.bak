/**
 * @file primitives.cpp
 * @brief Implementation of primitive shape generators
 */

#include "rendering/primitives.h"
#include "logging/logging.h"
#include <cmath>

namespace jupiter {
namespace rendering {
namespace primitives {

ghi::BufferHandle MeshData::createVertexBuffer() const {
    if (vertices.empty()) {
        return ghi::BufferHandle{};
    }
    
    return ghi::createBuffer({
        .type = ghi::BufferType::Vertex,
        .usage = ghi::BufferUsage::Static,
        .size = vertices.size() * sizeof(Vertex),
        .data = vertices.data()
    });
}

ghi::BufferHandle MeshData::createIndexBuffer() const {
    if (indices.empty()) {
        return ghi::BufferHandle{};
    }
    
    return ghi::createBuffer({
        .type = ghi::BufferType::Index,
        .usage = ghi::BufferUsage::Static,
        .size = indices.size() * sizeof(uint16_t),
        .data = indices.data()
    });
}

MeshData createCube() {
    MeshData mesh;
    
    // 24 vertices (4 per face, duplicated for proper normals)
    mesh.vertices = {
        // Front face (Z+)
        Vertex(glm::vec3(-0.5f, -0.5f,  0.5f), glm::vec3( 0.0f,  0.0f,  1.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f, -0.5f,  0.5f), glm::vec3( 0.0f,  0.0f,  1.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f,  0.5f), glm::vec3( 0.0f,  0.0f,  1.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3(-0.5f,  0.5f,  0.5f), glm::vec3( 0.0f,  0.0f,  1.0f), glm::vec2(0.0f, 1.0f)),
        
        // Back face (Z-)
        Vertex(glm::vec3( 0.5f, -0.5f, -0.5f), glm::vec3( 0.0f,  0.0f, -1.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3(-0.5f, -0.5f, -0.5f), glm::vec3( 0.0f,  0.0f, -1.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3(-0.5f,  0.5f, -0.5f), glm::vec3( 0.0f,  0.0f, -1.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f, -0.5f), glm::vec3( 0.0f,  0.0f, -1.0f), glm::vec2(0.0f, 1.0f)),
        
        // Right face (X+)
        Vertex(glm::vec3( 0.5f, -0.5f,  0.5f), glm::vec3( 1.0f,  0.0f,  0.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f, -0.5f, -0.5f), glm::vec3( 1.0f,  0.0f,  0.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f, -0.5f), glm::vec3( 1.0f,  0.0f,  0.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f,  0.5f), glm::vec3( 1.0f,  0.0f,  0.0f), glm::vec2(0.0f, 1.0f)),
        
        // Left face (X-)
        Vertex(glm::vec3(-0.5f, -0.5f, -0.5f), glm::vec3(-1.0f,  0.0f,  0.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3(-0.5f, -0.5f,  0.5f), glm::vec3(-1.0f,  0.0f,  0.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3(-0.5f,  0.5f,  0.5f), glm::vec3(-1.0f,  0.0f,  0.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3(-0.5f,  0.5f, -0.5f), glm::vec3(-1.0f,  0.0f,  0.0f), glm::vec2(0.0f, 1.0f)),
        
        // Top face (Y+)
        Vertex(glm::vec3(-0.5f,  0.5f,  0.5f), glm::vec3( 0.0f,  1.0f,  0.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f,  0.5f), glm::vec3( 0.0f,  1.0f,  0.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f,  0.5f, -0.5f), glm::vec3( 0.0f,  1.0f,  0.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3(-0.5f,  0.5f, -0.5f), glm::vec3( 0.0f,  1.0f,  0.0f), glm::vec2(0.0f, 1.0f)),
        
        // Bottom face (Y-)
        Vertex(glm::vec3(-0.5f, -0.5f, -0.5f), glm::vec3( 0.0f, -1.0f,  0.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f, -0.5f, -0.5f), glm::vec3( 0.0f, -1.0f,  0.0f), glm::vec2(1.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f, -0.5f,  0.5f), glm::vec3( 0.0f, -1.0f,  0.0f), glm::vec2(1.0f, 1.0f)),
        Vertex(glm::vec3(-0.5f, -0.5f,  0.5f), glm::vec3( 0.0f, -1.0f,  0.0f), glm::vec2(0.0f, 1.0f)),
    };
    
    // 36 indices (6 faces × 2 triangles × 3 indices)
    mesh.indices = {
        // Front
        0, 1, 2,  2, 3, 0,
        // Back
        4, 5, 6,  6, 7, 4,
        // Right
        8, 9, 10,  10, 11, 8,
        // Left
        12, 13, 14,  14, 15, 12,
        // Top
        16, 17, 18,  18, 19, 16,
        // Bottom
        20, 21, 22,  22, 23, 20,
    };
    
    return mesh;
}

MeshData createSphere(float radius, int segments, int rings) {
    MeshData mesh;
    
    const float PI = 3.14159265359f;
    
    // Generate vertices
    for (int ring = 0; ring <= rings; ++ring) {
        float phi = PI * float(ring) / float(rings);
        float y = radius * std::cos(phi);
        float ringRadius = radius * std::sin(phi);
        
        for (int seg = 0; seg <= segments; ++seg) {
            float theta = 2.0f * PI * float(seg) / float(segments);
            float x = ringRadius * std::cos(theta);
            float z = ringRadius * std::sin(theta);
            
            glm::vec3 pos(x, y, z);
            glm::vec3 normal = glm::normalize(pos);
            glm::vec2 uv(float(seg) / float(segments), float(ring) / float(rings));
            
            mesh.vertices.emplace_back(pos, normal, uv);
        }
    }
    
    // Generate indices
    for (int ring = 0; ring < rings; ++ring) {
        for (int seg = 0; seg < segments; ++seg) {
            int current = ring * (segments + 1) + seg;
            int next = current + segments + 1;
            
            // Two triangles per quad
            mesh.indices.push_back(current);
            mesh.indices.push_back(next);
            mesh.indices.push_back(current + 1);
            
            mesh.indices.push_back(current + 1);
            mesh.indices.push_back(next);
            mesh.indices.push_back(next + 1);
        }
    }
    
    return mesh;
}

MeshData createPlane(float width, float height, int subdivisions) {
    MeshData mesh;
    
    float halfWidth = width * 0.5f;
    float halfHeight = height * 0.5f;
    float stepX = width / float(subdivisions);
    float stepZ = height / float(subdivisions);
    
    // Generate vertices
    for (int z = 0; z <= subdivisions; ++z) {
        for (int x = 0; x <= subdivisions; ++x) {
            float px = -halfWidth + x * stepX;
            float pz = -halfHeight + z * stepZ;
            
            glm::vec3 pos(px, 0.0f, pz);
            glm::vec3 normal(0.0f, 1.0f, 0.0f);  // Up
            glm::vec2 uv(float(x) / float(subdivisions), float(z) / float(subdivisions));
            
            mesh.vertices.emplace_back(pos, normal, uv);
        }
    }
    
    // Generate indices
    int vertsPerRow = subdivisions + 1;
    for (int z = 0; z < subdivisions; ++z) {
        for (int x = 0; x < subdivisions; ++x) {
            int topLeft = z * vertsPerRow + x;
            int topRight = topLeft + 1;
            int bottomLeft = (z + 1) * vertsPerRow + x;
            int bottomRight = bottomLeft + 1;
            
            // Two triangles per quad
            mesh.indices.push_back(topLeft);
            mesh.indices.push_back(bottomLeft);
            mesh.indices.push_back(topRight);
            
            mesh.indices.push_back(topRight);
            mesh.indices.push_back(bottomLeft);
            mesh.indices.push_back(bottomRight);
        }
    }
    
    return mesh;
}

MeshData createTriangle() {
    MeshData mesh;
    
    // Simple triangle for testing (no indices, just 3 vertices)
    mesh.vertices = {
        Vertex(glm::vec3( 0.0f,  0.5f, 0.0f), glm::vec3(0.0f, 0.0f, 1.0f), glm::vec2(0.5f, 1.0f)),
        Vertex(glm::vec3(-0.5f, -0.5f, 0.0f), glm::vec3(0.0f, 0.0f, 1.0f), glm::vec2(0.0f, 0.0f)),
        Vertex(glm::vec3( 0.5f, -0.5f, 0.0f), glm::vec3(0.0f, 0.0f, 1.0f), glm::vec2(1.0f, 0.0f)),
    };
    
    // No indices (direct vertex draw)
    
    return mesh;
}

} // namespace primitives
} // namespace rendering
} // namespace jupiter
